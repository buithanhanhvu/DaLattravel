@using WebDuLichDaLat.Models
@model IEnumerable<WebDuLichDaLat.Models.TouristPlace>

@{
    Layout = "~/Views/Shared/_LayoutNoFooter.cshtml";
    var categories = ViewBag.Categories as IEnumerable<WebDuLichDaLat.Models.Category>;
    var regions = ViewBag.Regions as IEnumerable<WebDuLichDaLat.Models.Region>;
    var touristPlacesList = Model?.ToList() ?? new List<WebDuLichDaLat.Models.TouristPlace>();
    var selectedCategoryId = ViewContext.HttpContext.Request.Query["categoryId"].ToString();
    var selectedRegionId = ViewContext.HttpContext.Request.Query["regionId"].ToString();
}

<!-- Main Content Section -->
<section id="places-section" style="background-color: #1a1a1a; color: white; min-height: 100vh; padding: 100px 0 40px 0;">
    <div class="container-fluid px-4">
        <div class="row">
            <!-- Sidebar Filters -->
            <div class="col-lg-3 mb-4">
                <div class="filter-sidebar" style="background-color: #2a2a2a; border-radius: 15px; padding: 25px; position: sticky; top: 100px;">
                    <h3 class="mb-4" style="font-size: 24px; font-weight: 700; color: white;">Bộ lọc</h3>
                    
                    <!-- Search -->
                    <div class="mb-4">
                        <form method="get" action="@Url.Action("Search", "TouristPlace")">
                            <div class="input-group">
                                <input type="text" name="query" class="form-control" placeholder="Tìm kiếm địa điểm..." 
                                       style="background-color: #1a1a1a; border: 1px solid #444; color: white; border-radius: 8px 0 0 8px; padding: 12px;">
                                <button class="btn" type="submit" style="background-color: #ff6b9d; color: white; border-radius: 0 8px 8px 0; border: none; padding: 12px 20px;">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Category Filter -->
                    <div class="mb-4">
                        <h5 class="mb-3" style="font-size: 18px; font-weight: 600; color: #ff6b9d;">Danh mục</h5>
                        <div class="filter-list">
                            <a href="@Url.Action("Index", "TouristPlace")" 
                               class="filter-item d-block mb-2 p-2 rounded @(string.IsNullOrEmpty(selectedCategoryId) ? "active" : "")"
                               style="color: white; text-decoration: none; background-color: @(string.IsNullOrEmpty(selectedCategoryId) ? "rgba(255,107,157,0.2)" : "transparent"); transition: all 0.3s ease;">
                                <i class="bi bi-grid me-2"></i> Tất cả
                            </a>
                            @if (categories != null)
                            {
                                @foreach (var category in categories)
                                {
                                    <a href="@Url.Action("Index", "TouristPlace", new { categoryId = category.Id })" 
                                       class="filter-item d-block mb-2 p-2 rounded @(selectedCategoryId == category.Id.ToString() ? "active" : "")"
                                       style="color: white; text-decoration: none; background-color: @(selectedCategoryId == category.Id.ToString() ? "rgba(255,107,157,0.2)" : "transparent"); transition: all 0.3s ease;">
                                        <i class="bi bi-tag me-2"></i> @category.Name
                                    </a>
                                }
                            }
                        </div>
                    </div>

                    <!-- Region Filter -->
                    <div class="mb-4">
                        <h5 class="mb-3" style="font-size: 18px; font-weight: 600; color: #ff6b9d;">Khu vực</h5>
                        <div class="filter-list">
                            <a href="@Url.Action("Index", "TouristPlace", new { categoryId = selectedCategoryId })" 
                               class="filter-item d-block mb-2 p-2 rounded @(string.IsNullOrEmpty(selectedRegionId) ? "active" : "")"
                               style="color: white; text-decoration: none; background-color: @(string.IsNullOrEmpty(selectedRegionId) ? "rgba(255,107,157,0.2)" : "transparent"); transition: all 0.3s ease;">
                                <i class="bi bi-geo-alt me-2"></i> Tất cả
                            </a>
                            @if (regions != null)
                            {
                                @foreach (var region in regions)
                                {
                                    <a href="@Url.Action("Index", "TouristPlace", new { categoryId = selectedCategoryId, regionId = region.Id })" 
                                       class="filter-item d-block mb-2 p-2 rounded @(selectedRegionId == region.Id.ToString() ? "active" : "")"
                                       style="color: white; text-decoration: none; background-color: @(selectedRegionId == region.Id.ToString() ? "rgba(255,107,157,0.2)" : "transparent"); transition: all 0.3s ease;">
                                        <i class="bi bi-pin-map me-2"></i> @region.Name
                                    </a>
                                }
                            }
                        </div>
                    </div>

                    <!-- Map Link -->
                    <div class="mt-4">
                        <a href="@Url.Action("Map", "TouristPlace")" class="btn w-100" 
                           style="background-color: #ff6b9d; color: white; border: none; border-radius: 8px; padding: 12px; font-weight: 600; text-decoration: none; display: block; text-align: center; transition: all 0.3s ease;">
                            <i class="bi bi-map me-2"></i> Xem trên bản đồ
                        </a>
                    </div>
                </div>
            </div>

            <!-- Main Content - Places Grid -->
            <div class="col-lg-9">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1" style="font-size: 36px; font-weight: 700; color: white;">
                            Danh sách địa điểm
                        </h2>
                        <p class="text-muted mb-0" style="color: rgba(255,255,255,0.6); font-size: 16px;">
                            Tìm thấy @touristPlacesList.Count địa điểm
                        </p>
                    </div>
                </div>

                <!-- Places Grid -->
                @if (touristPlacesList.Any())
                {
                    <div class="row g-4">
                        @foreach (var place in touristPlacesList)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="place-card" 
                                     style="background-color: #2a2a2a; border-radius: 15px; overflow: hidden; cursor: pointer; transition: all 0.3s ease; height: 100%; display: flex; flex-direction: column;"
                                     onclick="window.location.href='@Url.Action("Display", "TouristPlace", new { id = place.Id })'">
                                    <!-- Image -->
                                    <div class="position-relative" style="height: 250px; overflow: hidden; flex-shrink: 0;">
                                        <img src="@(place.ImageUrl ?? "/Images/default-place.jpg")" 
                                             alt="@place.Name"
                                             style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;">
                                        <!-- Rating Badge -->
                                        <div class="position-absolute top-0 end-0 m-3">
                                            @{
                                                var avgRating = place.Rating;
                                                var reviewCount = place.Reviews?.Count ?? 0;
                                            }
                                            <span class="badge" style="background-color: rgba(0,0,0,0.8); color: #ffd700; padding: 8px 12px; border-radius: 20px; font-size: 14px; font-weight: 600; backdrop-filter: blur(10px);">
                                                <i class="bi bi-star-fill me-1"></i> @avgRating
                                                @if (reviewCount > 0)
                                                {
                                                    <span style="font-size: 11px; color: rgba(255,255,255,0.7);">(@reviewCount)</span>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <!-- Content -->
                                    <div class="p-4" style="flex-grow: 1; display: flex; flex-direction: column;">
                                        <!-- Category & Region -->
                                        <div class="d-flex gap-2 mb-2 flex-wrap">
                                            @if (place.Category != null)
                                            {
                                                <span class="badge" style="background-color: rgba(255,107,157,0.2); color: #ff6b9d; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 500;">
                                                    @place.Category.Name
                                                </span>
                                            }
                                            @if (place.Region != null)
                                            {
                                                <span class="badge" style="background-color: rgba(255,255,255,0.1); color: white; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 500;">
                                                    @place.Region.Name
                                                </span>
                                            }
                                        </div>
                                        
                                        <!-- Name -->
                                        <h4 class="mb-2" style="font-size: 20px; font-weight: 700; color: white; line-height: 1.3; flex-grow: 0;">
                                            @place.Name
                                        </h4>
                                        
                                        <!-- Description -->
                                        @if (!string.IsNullOrEmpty(place.Description))
                                        {
                                            <p class="mb-3" style="color: rgba(255,255,255,0.7); font-size: 14px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex-grow: 1;">
                                                @(place.Description.Length > 100 ? place.Description.Substring(0, 100) + "..." : place.Description)
                                            </p>
                                        }
                                        
                                        <!-- View Details Button -->
                                        <div class="d-flex align-items-center mt-auto" style="color: #ff6b9d; font-weight: 600; font-size: 14px; transition: all 0.3s ease;">
                                            Xem chi tiết <i class="bi bi-arrow-right ms-2"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Empty State -->
                    <div class="text-center py-5">
                        <i class="bi bi-inbox" style="font-size: 64px; color: rgba(255,255,255,0.3);"></i>
                        <h3 class="mt-3 mb-2" style="color: white; font-size: 24px;">Không tìm thấy địa điểm</h3>
                        <p class="text-muted mb-4" style="color: rgba(255,255,255,0.6);">
                            Hãy thử thay đổi bộ lọc hoặc tìm kiếm với từ khóa khác
                        </p>
                        <a href="@Url.Action("Index", "TouristPlace")" class="btn" 
                           style="background-color: #ff6b9d; color: white; border: none; border-radius: 8px; padding: 12px 30px; font-weight: 600; text-decoration: none; transition: all 0.3s ease;">
                            Xem tất cả địa điểm
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<style>
    .filter-item {
        display: block;
        padding: 10px 12px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .filter-item:hover {
        background-color: rgba(255,107,157,0.15) !important;
        transform: translateX(5px);
        color: #ff6b9d !important;
    }

    .filter-item.active {
        background-color: rgba(255,107,157,0.2) !important;
        color: #ff6b9d !important;
    }

    .place-card {
        transition: all 0.3s ease;
    }

    .place-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 40px rgba(255,107,157,0.3);
    }

    .place-card:hover img {
        transform: scale(1.1);
    }

    .place-card:hover .d-flex.align-items-center {
        transform: translateX(5px);
    }

    .filter-sidebar {
        max-height: calc(100vh - 120px);
        overflow-y: auto;
    }

    .filter-sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .filter-sidebar::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.1);
        border-radius: 3px;
    }

    .filter-sidebar::-webkit-scrollbar-thumb {
        background: rgba(255,107,157,0.5);
        border-radius: 3px;
    }

    .filter-sidebar::-webkit-scrollbar-thumb:hover {
        background: rgba(255,107,157,0.7);
    }

    .btn:hover {
        background-color: #ff5a8a !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255,107,157,0.4);
    }

    @@media (max-width: 992px) {
        .filter-sidebar {
            position: relative !important;
            top: 0 !important;
            margin-bottom: 30px;
        }

        #places-section {
            padding: 20px 0;
        }
    }

    @@media (max-width: 768px) {
        #places-section {
            margin-top: 0;
            padding: 20px 0;
        }

        .place-card {
            margin-bottom: 20px;
        }
    }
</style>
