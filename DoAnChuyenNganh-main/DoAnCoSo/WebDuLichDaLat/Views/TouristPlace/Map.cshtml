@using WebDuLichDaLat.Models
@model IEnumerable<WebDuLichDaLat.Models.TouristPlace>

@{
    var categories = ViewBag.Categories as IEnumerable<WebDuLichDaLat.Models.Category>;
    var regions = ViewBag.Manufacturers as IEnumerable<WebDuLichDaLat.Models.Region>;
    var touristPlacesList = Model?.ToList() ?? new List<WebDuLichDaLat.Models.TouristPlace>();
    var touristPlacesJson = ViewBag.TouristPlacesJson as string;
    
    // Hide navbar on map page
    ViewBag.HideNavbar = true;
}

<!-- Main Content: Sidebar + Map -->
<div class="places-container" style="display: flex; height: 100vh; margin-top: 0; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999;">
    <!-- Left Sidebar -->
    <div class="places-sidebar" style="width: 350px; background-color: #8B1538; color: white; overflow-y: auto; padding: 20px;">
        <div class="sidebar-header mb-4">
            <h3 class="d-flex align-items-center mb-3" style="font-weight: 600; font-size: 24px;">
                <i class="bi bi-geo-alt-fill me-2"></i>
                Địa điểm
            </h3>
            
            <!-- Search -->
            <div class="search-box mb-3">
                <div class="input-group">
                    <span class="input-group-text bg-white border-0">
                        <i class="bi bi-search text-dark"></i>
                    </span>
                    <input type="text" id="placeSearch" class="form-control border-0" placeholder="Tìm kiếm địa điểm..." 
                           style="background-color: rgba(255,255,255,0.9);">
                </div>
            </div>

            <!-- Filter by Category -->
            @if (categories != null && categories.Any())
            {
                <div class="mb-3">
                    <select id="categoryFilter" class="form-select" style="background-color: rgba(255,255,255,0.9);">
                        <option value="">Tất cả danh mục</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
            }
        </div>

        <!-- Places List -->
        <div class="places-list" id="placesList">
            @if (touristPlacesList.Any())
            {
                @foreach (var place in touristPlacesList)
                {
                    <div class="place-item mb-3 p-3 rounded" 
                         data-place-id="@place.Id"
                         data-lat="@place.Latitude"
                         data-lng="@place.Longitude"
                         data-category="@place.CategoryId"
                         data-name="@place.Name.ToLower()"
                         style="background-color: rgba(255,255,255,0.1); cursor: pointer; transition: all 0.3s ease;"
                         onmouseover="this.style.backgroundColor='rgba(255,255,255,0.2)'"
                         onmouseout="this.style.backgroundColor='rgba(255,255,255,0.1)'"
                         onclick="selectPlace('@place.Id', @place.Latitude, @place.Longitude, '@place.Name')">
                        <div class="d-flex align-items-center">
                            <img src="@(place.ImageUrl ?? "/Images/default-place.jpg")" 
                                 alt="@place.Name"
                                 class="rounded me-3"
                                 style="width: 60px; height: 60px; object-fit: cover;">
                            <div class="flex-grow-1">
                                <h6 class="mb-1" style="font-weight: 600; font-size: 16px;">@place.Name</h6>
                                <small class="text-white-50">@(place.Category?.Name ?? "Địa điểm")</small>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-white-50">Không có địa điểm nào.</p>
            }
        </div>
    </div>

    <!-- Right Map Area -->
    <div class="map-container" style="flex: 1; position: relative; background-color: #1a1a1a;">
        <!-- Map Controls Top Right -->
        <div class="map-controls-top" style="position: absolute; top: 15px; right: 15px; z-index: 1000; background-color: #8B1538; border-radius: 5px; padding: 5px; display: flex; gap: 10px;">
            <button class="btn btn-sm text-white border-0" style="background: transparent;" onclick="toggleSearch()">
                <i class="bi bi-search"></i>
            </button>
            <div style="width: 1px; background-color: rgba(255,255,255,0.3);"></div>
            <a href="@Url.Action("Index", "TouristPlace")" class="btn btn-sm text-white border-0" style="background: transparent; text-decoration: none;">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>

        <!-- Map -->
        <div id="placesMap" style="width: 100%; height: 100%;"></div>

        <!-- Map Controls Bottom Right -->
        <div class="map-controls-bottom" style="position: absolute; bottom: 15px; right: 15px; z-index: 1000; background-color: #8B1538; border-radius: 5px; padding: 8px; display: flex; flex-direction: column; gap: 5px;">
            <div class="btn-group-vertical">
                <button class="btn btn-sm text-white border-0" style="background: transparent;" onclick="changeMapView()">
                    <i class="bi bi-layers"></i> Đổi chế độ xem
                </button>
            </div>
            <div style="width: 100%; height: 1px; background-color: rgba(255,255,255,0.3); margin: 5px 0;"></div>
            <div class="btn-group-vertical">
                <button class="btn btn-sm text-white border-0" style="background: transparent;" onclick="mapZoomIn()">
                    <i class="bi bi-plus-lg"></i>
                </button>
                <button class="btn btn-sm text-white border-0" style="background: transparent;" onclick="mapZoomOut()">
                    <i class="bi bi-dash-lg"></i>
                </button>
            </div>
        </div>

        <!-- Map Attribution -->
        <div style="position: absolute; bottom: 5px; left: 10px; z-index: 1000; color: rgba(255,255,255,0.7); font-size: 11px;">
            © MapTiler © OpenStreetMap contributors
        </div>
    </div>
</div>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .places-sidebar::-webkit-scrollbar {
        width: 8px;
    }

    .places-sidebar::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.1);
    }

    .places-sidebar::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.3);
        border-radius: 4px;
    }

    .places-sidebar::-webkit-scrollbar-thumb:hover {
        background: rgba(255,255,255,0.5);
    }

    .place-item.active {
        background-color: rgba(255,255,255,0.3) !important;
        border-left: 3px solid #ffd700;
    }

    .map-controls-top button:hover,
    .map-controls-bottom button:hover {
        background-color: rgba(255,255,255,0.1) !important;
    }

    @@media (max-width: 768px) {
        .places-container {
            flex-direction: column;
        }

        .places-sidebar {
            width: 100% !important;
            height: 300px;
        }

        .map-container {
            height: calc(100vh - 300px);
        }
    }
</style>

@section Scripts {
    <script>
        var map;
        var markers = [];
        var selectedPlaceId = null;
        var touristPlaces = @Html.Raw(touristPlacesJson ?? "[]");

        // Initialize Map
        function initMap() {
            map = L.map('placesMap', {
                center: [11.9404, 108.4583], // Đà Lạt coordinates
                zoom: 13,
                zoomControl: false // Disable default zoom controls
            });

            // Dark theme map tiles
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);

            // Add markers for all places
            touristPlaces.forEach(function(place) {
                if (place.Latitude && place.Longitude) {
                    var marker = L.marker([place.Latitude, place.Longitude])
                        .addTo(map)
                        .bindPopup('<b>' + place.Name + '</b><br/><a href="@Url.Action("Display", "TouristPlace")?id=' + place.Id + '">Xem chi tiết</a>');
                    marker.placeId = place.Id;
                    markers.push(marker);
                }
            });

            // Fit bounds to show all markers
            if (markers.length > 0) {
                var group = new L.featureGroup(markers);
                map.fitBounds(group.getBounds().pad(0.1));
            }
        }

        // Select place from sidebar
        function selectPlace(placeId, lat, lng, name) {
            // Update active state
            document.querySelectorAll('.place-item').forEach(item => {
                item.classList.remove('active');
            });
            var item = document.querySelector(`[data-place-id="${placeId}"]`);
            if (item) item.classList.add('active');
            
            selectedPlaceId = placeId;
            
            // Center map on selected place
            map.setView([lat, lng], 15);
            
            // Open popup for selected marker
            var marker = markers.find(m => m.placeId === placeId);
            if (marker) {
                marker.openPopup();
            }
        }

        // Search functionality
        document.getElementById('placeSearch')?.addEventListener('input', function(e) {
            var searchTerm = e.target.value.toLowerCase();
            filterPlaces(searchTerm);
        });

        // Category filter
        document.getElementById('categoryFilter')?.addEventListener('change', function(e) {
            var categoryId = e.target.value;
            filterPlaces(null, categoryId);
        });

        function filterPlaces(searchTerm, categoryId) {
            var items = document.querySelectorAll('.place-item');
            items.forEach(item => {
                var name = item.getAttribute('data-name') || '';
                var itemCategory = item.getAttribute('data-category') || '';
                
                var matchSearch = !searchTerm || name.includes(searchTerm);
                var matchCategory = !categoryId || itemCategory === categoryId;
                
                if (matchSearch && matchCategory) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Map controls
        function toggleSearch() {
            var searchBox = document.getElementById('placeSearch');
            if (searchBox) {
                searchBox.focus();
            }
        }

        function changeMapView() {
            alert('Chức năng đổi chế độ xem bản đồ sẽ được thêm sau');
        }

        function mapZoomIn() {
            map.zoomIn();
        }

        function mapZoomOut() {
            map.zoomOut();
        }

        // Initialize on page load
        window.onload = function() {
            initMap();
        };
    </script>
}

