@model IEnumerable<WebDuLichDaLat.Models.Restaurant>
@{
    ViewData["Title"] = "Danh sách nhà hàng & quán ăn";
    Layout = "~/Views/Shared/_LayoutNoFooter.cshtml";
    var search = ViewBag.Search as string;
    var minPrice = ViewBag.MinPrice as decimal?;
    var maxPrice = ViewBag.MaxPrice as decimal?;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
}

<!-- Main Content Section -->
<section id="restaurants-section" style="background-color: #1a1a1a; color: white; min-height: 100vh; padding: 100px 0 40px 0;">
    <div class="container-fluid px-4">
        <div class="row">
            <!-- Sidebar Filters -->
            <div class="col-lg-3 mb-4">
                <div class="filter-sidebar" style="background-color: #2a2a2a; border-radius: 15px; padding: 25px; position: sticky; top: 100px;">
                    <h3 class="mb-4" style="font-size: 24px; font-weight: 700; color: white;">Bộ lọc</h3>
                    
                    <!-- Search -->
                    <form method="get" action="@Url.Action("Index", "Restaurant")">
                        <div class="mb-4">
                            <div class="input-group">
                                <input type="text" name="search" class="form-control" placeholder="Tìm kiếm nhà hàng..." 
                                       value="@search"
                                       style="background-color: #1a1a1a; border: 1px solid #444; color: white; border-radius: 8px 0 0 8px; padding: 12px;">
                                <button class="btn" type="submit" style="background-color: #ff6b9d; color: white; border-radius: 0 8px 8px 0; border: none; padding: 12px 20px;">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Price Filter -->
                        <div class="mb-4">
                            <h5 class="mb-3" style="font-size: 18px; font-weight: 600; color: #ff6b9d;">Giá trung bình/người (VNĐ)</h5>
                            <div class="mb-2">
                                <input type="number" name="minPrice" class="form-control" placeholder="Từ" 
                                       value="@minPrice" 
                                       style="background-color: #1a1a1a; border: 1px solid #444; color: white; border-radius: 8px; padding: 10px; margin-bottom: 10px;">
                            </div>
                            <div>
                                <input type="number" name="maxPrice" class="form-control" placeholder="Đến" 
                                       value="@maxPrice"
                                       style="background-color: #1a1a1a; border: 1px solid #444; color: white; border-radius: 8px; padding: 10px;">
                            </div>
                        </div>

                        <button type="submit" class="btn w-100" 
                                style="background-color: #ff6b9d; color: white; border: none; border-radius: 8px; padding: 12px; font-weight: 600;">
                            <i class="bi bi-funnel me-2"></i> Lọc
                        </button>
                    </form>

                    <!-- Clear Filter -->
                    <a href="@Url.Action("Index", "Restaurant")" class="btn w-100 mt-2" 
                       style="background-color: rgba(255,255,255,0.1); color: white; border: none; border-radius: 8px; padding: 12px; font-weight: 600; text-decoration: none; display: block; text-align: center;">
                        <i class="bi bi-x-circle me-2"></i> Xóa bộ lọc
                    </a>
                </div>
            </div>

            <!-- Main Content - Restaurants Grid -->
            <div class="col-lg-9">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1" style="font-size: 36px; font-weight: 700; color: white;">
                            Danh sách nhà hàng & quán ăn
                        </h2>
                        <p class="text-muted mb-0" style="color: rgba(255,255,255,0.6); font-size: 16px;">
                            Tìm thấy @totalCount nhà hàng/quán ăn
                        </p>
                    </div>
                </div>

                <!-- Restaurants Grid -->
                @if (Model != null && Model.Any())
                {
                    <div class="row g-4">
                        @foreach (var restaurant in Model)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="restaurant-card" 
                                     style="background-color: #2a2a2a; border-radius: 15px; overflow: hidden; cursor: pointer; transition: all 0.3s ease; height: 100%; display: flex; flex-direction: column;"
                                     onclick="window.location.href='@Url.Action("Detail", "Restaurant", new { id = restaurant.Id })'">
                                    <!-- Icon/Image Placeholder -->
                                    <div class="position-relative" style="height: 200px; overflow: hidden; flex-shrink: 0; background: linear-gradient(135deg, #ff6b9d 0%, #ff8fab 100%); display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-cup-hot" style="font-size: 64px; color: rgba(255,255,255,0.3);"></i>
                                        <!-- Price Badge -->
                                        <div class="position-absolute top-0 end-0 m-3">
                                            <span class="badge" style="background-color: rgba(0,0,0,0.8); color: #ffd700; padding: 8px 12px; border-radius: 20px; font-size: 14px; font-weight: 600; backdrop-filter: blur(10px);">
                                                @string.Format("{0:N0}", restaurant.AveragePricePerPerson) đ/người
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <!-- Content -->
                                    <div class="p-4" style="flex-grow: 1; display: flex; flex-direction: column;">
                                        <!-- Tourist Place Badge -->
                                        @if (restaurant.TouristPlace != null)
                                        {
                                            <div class="mb-2">
                                                <span class="badge" style="background-color: rgba(255,107,157,0.2); color: #ff6b9d; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 500;">
                                                    <i class="bi bi-geo-alt me-1"></i> @restaurant.TouristPlace.Name
                                                </span>
                                            </div>
                                        }
                                        
                                        <!-- Name -->
                                        <h4 class="mb-2" style="font-size: 20px; font-weight: 700; color: white; line-height: 1.3; flex-grow: 0;">
                                            @restaurant.Name
                                        </h4>
                                        
                                        <!-- Address -->
                                        @if (!string.IsNullOrEmpty(restaurant.Address))
                                        {
                                            <p class="mb-2" style="color: rgba(255,255,255,0.7); font-size: 14px; line-height: 1.5; flex-grow: 1;">
                                                <i class="bi bi-geo-alt-fill me-2" style="color: #ff6b9d;"></i> @restaurant.Address
                                            </p>
                                        }
                                        
                                        <!-- Phone -->
                                        @if (!string.IsNullOrEmpty(restaurant.Phone))
                                        {
                                            <p class="mb-3" style="color: rgba(255,255,255,0.7); font-size: 14px;">
                                                <i class="bi bi-telephone-fill me-2" style="color: #ff6b9d;"></i> @restaurant.Phone
                                            </p>
                                        }
                                        
                                        <!-- View Details Button -->
                                        <div class="d-flex align-items-center mt-auto" style="color: #ff6b9d; font-weight: 600; font-size: 14px; transition: all 0.3s ease;">
                                            Xem chi tiết <i class="bi bi-arrow-right ms-2"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Empty State -->
                    <div class="text-center py-5">
                        <i class="bi bi-cup-hot" style="font-size: 64px; color: rgba(255,255,255,0.3);"></i>
                        <h3 class="mt-3 mb-2" style="color: white; font-size: 24px;">Không tìm thấy nhà hàng</h3>
                        <p class="text-muted" style="color: rgba(255,255,255,0.6);">
                            Hãy thử thay đổi bộ lọc hoặc tìm kiếm với từ khóa khác
                        </p>
                        <a href="@Url.Action("Index", "Restaurant")" class="btn mt-3" 
                           style="background-color: #ff6b9d; color: white; border: none; border-radius: 8px; padding: 12px 30px; font-weight: 600; text-decoration: none;">
                            Xem tất cả nhà hàng
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<style>
    .restaurant-card {
        transition: all 0.3s ease;
    }

    .restaurant-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 40px rgba(255,107,157,0.3);
    }

    .restaurant-card:hover .d-flex.align-items-center {
        transform: translateX(5px);
        color: #ff5a8a !important;
    }

    .filter-sidebar {
        max-height: calc(100vh - 120px);
        overflow-y: auto;
    }

    .filter-sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .filter-sidebar::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.1);
        border-radius: 3px;
    }

    .filter-sidebar::-webkit-scrollbar-thumb {
        background: rgba(255,107,157,0.5);
        border-radius: 3px;
    }

    .filter-sidebar::-webkit-scrollbar-thumb:hover {
        background: rgba(255,107,157,0.7);
    }

    .btn:hover {
        background-color: #ff5a8a !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255,107,157,0.4);
    }

    @@media (max-width: 992px) {
        .filter-sidebar {
            position: relative !important;
            top: 0 !important;
            margin-bottom: 30px;
        }

        #restaurants-section {
            padding: 20px 0;
        }
    }
</style>




