@model IEnumerable<WebDuLichDaLat.Models.BlogPost>
@{
    ViewData["Title"] = "Tin tức";
}

<!-- Main Content Section -->
<section id="blog-section" style="background-color: #1a1a1a; color: white; min-height: 100vh; padding: 40px 0;">
    <div class="container-fluid px-4">
        <!-- Header -->
        <div class="row mb-5">
            <div class="col-12">
                <h2 class="mb-2" style="font-size: 36px; font-weight: 700; color: white;">
                    Bài viết mới nhất
                </h2>
                <p class="text-muted mb-0" style="color: rgba(255,255,255,0.6); font-size: 16px;">
                    Cập nhật các tin tức và xu hướng du lịch từ Đà Lạt
                </p>
            </div>
        </div>

        <!-- Blog Posts Grid -->
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var post in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="blog-card" 
                             style="background-color: #2a2a2a; border-radius: 15px; overflow: hidden; cursor: pointer; transition: all 0.3s ease; height: 100%; display: flex; flex-direction: column;"
                             onclick="window.location.href='@Url.Action("Detail", "Blog", new { id = post.Id })'">
                            <!-- Image -->
                            <div class="position-relative" style="height: 250px; overflow: hidden; flex-shrink: 0;">
                                <img src="@Url.Content($"~/Images/{System.IO.Path.GetFileName(post.ImageUrl)}")"
                                     class="blog-image"
                                     alt="@post.Title"
                                     style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" />
                                <!-- Date Badge -->
                                <div class="position-absolute bottom-0 start-0 m-3">
                                    <span class="badge" style="background-color: rgba(0,0,0,0.8); color: white; padding: 8px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; backdrop-filter: blur(10px);">
                                        <i class="bi bi-calendar3 me-1"></i> @post.PostedDate.ToString("dd MMM yyyy")
                                    </span>
                                </div>
                            </div>
                            
                            <!-- Content -->
                            <div class="p-4" style="flex-grow: 1; display: flex; flex-direction: column;">
                                <!-- Title -->
                                <h5 class="mb-3" style="font-size: 20px; font-weight: 700; color: white; line-height: 1.3; flex-grow: 0;">
                                    @post.Title
                                </h5>
                                
                                <!-- Content Preview -->
                                <p class="mb-3" style="color: rgba(255,255,255,0.7); font-size: 14px; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; flex-grow: 1;">
                                    @((post.Content?.Length > 150) ? post.Content.Substring(0, 150) + "..." : post.Content ?? "")
                                </p>
                                
                                <!-- Read More Button -->
                                <div class="d-flex align-items-center mt-auto" style="color: #ff6b9d; font-weight: 600; font-size: 14px; transition: all 0.3s ease;">
                                    Đọc thêm <i class="bi bi-arrow-right ms-2"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="col-12 text-center py-5">
                    <i class="bi bi-journal-text" style="font-size: 64px; color: rgba(255,255,255,0.3);"></i>
                    <h3 class="mt-3 mb-2" style="color: white; font-size: 24px;">Chưa có bài viết nào</h3>
                    <p class="text-muted" style="color: rgba(255,255,255,0.6);">
                        Các bài viết sẽ được cập nhật sớm nhất
                    </p>
                </div>
            }

            <!-- Admin Button -->
            @if (User.IsInRole("Admin"))
            {
                <div class="col-12 text-end mt-4">
                    <a asp-area="Admin" asp-controller="Blog" asp-action="Index" 
                       class="btn" 
                       style="background-color: #ff6b9d; color: white; border: none; border-radius: 8px; padding: 12px 30px; font-weight: 600; text-decoration: none; transition: all 0.3s ease;">
                        <i class="bi bi-plus-circle me-2"></i> Quản lý bài viết
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .blog-card {
        transition: all 0.3s ease;
    }

    .blog-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 40px rgba(255,107,157,0.3);
    }

    .blog-card:hover .blog-image {
        transform: scale(1.1);
    }

    .blog-card:hover .d-flex.align-items-center {
        transform: translateX(5px);
        color: #ff5a8a !important;
    }

    .btn:hover {
        background-color: #ff5a8a !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255,107,157,0.4);
    }

    @@media (max-width: 768px) {
        #blog-section {
            padding: 20px 0;
        }

        .blog-card {
            margin-bottom: 20px;
        }
    }
</style>
