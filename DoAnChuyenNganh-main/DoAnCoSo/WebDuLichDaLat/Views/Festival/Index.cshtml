@model IEnumerable<WebDuLichDaLat.Models.Festival>
@{
    Layout = "~/Views/Shared/_LayoutNoFooter.cshtml";
    ViewData["Title"] = "Lễ hội & Sự kiện";
}

<!-- Main Content Section -->
<section id="festival-section" style="background-color: #1a1a1a; color: white; min-height: 100vh; padding: 100px 0 40px 0;">
    <div class="container-fluid px-4">
        <!-- Header -->
        <div class="row mb-5">
            <div class="col-12">
                <h2 class="mb-2" style="font-size: 36px; font-weight: 700; color: white;">
                    Lễ hội & Sự kiện Đà Lạt
                </h2>
                <p class="text-muted mb-0" style="color: rgba(255,255,255,0.6); font-size: 16px;">
                    Khám phá các lễ hội văn hóa và sự kiện đặc sắc tại Đà Lạt
                </p>
            </div>
        </div>

        <!-- Festivals Grid -->
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var festival in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="festival-card" 
                             style="background-color: #2a2a2a; border-radius: 15px; overflow: hidden; cursor: pointer; transition: all 0.3s ease; height: 100%; display: flex; flex-direction: column;"
                             onclick="window.location.href='@Url.Action("Detail", "Festival", new { id = festival.Id })'">
                            <!-- Image -->
                            <div class="position-relative" style="height: 250px; overflow: hidden; flex-shrink: 0;">
                                @if (!string.IsNullOrEmpty(festival.ImageUrl))
                                {
                                    <img src="@Url.Content($"~/Images/{System.IO.Path.GetFileName(festival.ImageUrl)}")"
                                         class="festival-image"
                                         alt="@festival.Title"
                                         style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" />
                                }
                                else
                                {
                                    <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-calendar-event" style="font-size: 64px; color: rgba(255,255,255,0.5);"></i>
                                    </div>
                                }
                                
                                <!-- Date Badge -->
                                <div class="position-absolute top-0 start-0 m-3">
                                    <span class="badge" style="background-color: rgba(255,107,157,0.9); color: white; padding: 8px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; backdrop-filter: blur(10px);">
                                        <i class="bi bi-calendar3 me-1"></i> 
                                        @festival.StartDate.ToString("dd/MM/yyyy")
                                        @if (festival.EndDate.HasValue && festival.EndDate.Value != festival.StartDate)
                                        {
                                            <text> - @festival.EndDate.Value.ToString("dd/MM/yyyy")</text>
                                        }
                                    </span>
                                </div>
                                
                                <!-- Event Type Badge -->
                                @if (!string.IsNullOrEmpty(festival.EventType))
                                {
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="badge" style="background-color: rgba(0,0,0,0.8); color: white; padding: 6px 10px; border-radius: 15px; font-size: 11px; font-weight: 500;">
                                            @festival.EventType
                                        </span>
                                    </div>
                                }
                            </div>
                            
                            <!-- Content -->
                            <div class="p-4" style="flex-grow: 1; display: flex; flex-direction: column;">
                                <!-- Title -->
                                <h5 class="mb-3" style="font-size: 20px; font-weight: 700; color: white; line-height: 1.3; flex-grow: 0;">
                                    @festival.Title
                                </h5>
                                
                                <!-- Description Preview -->
                                <p class="mb-3" style="color: rgba(255,255,255,0.7); font-size: 14px; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; flex-grow: 1;">
                                    @((festival.Description?.Length > 150) ? festival.Description.Substring(0, 150) + "..." : festival.Description ?? "")
                                </p>
                                
                                <!-- Info Icons -->
                                <div class="d-flex flex-wrap gap-3 mb-3" style="font-size: 13px; color: rgba(255,255,255,0.6);">
                                    @if (!string.IsNullOrEmpty(festival.Location))
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-geo-alt me-1"></i>
                                            <span>@festival.Location</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(festival.TicketPrice))
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-ticket-perforated me-1"></i>
                                            <span>@festival.TicketPrice</span>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Read More Button -->
                                <div class="d-flex align-items-center mt-auto" style="color: #ff6b9d; font-weight: 600; font-size: 14px; transition: all 0.3s ease;">
                                    Xem chi tiết <i class="bi bi-arrow-right ms-2"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="col-12 text-center py-5">
                    <i class="bi bi-calendar-x" style="font-size: 64px; color: rgba(255,255,255,0.3);"></i>
                    <h3 class="mt-3 mb-2" style="color: white; font-size: 24px;">Chưa có lễ hội nào</h3>
                    <p class="text-muted" style="color: rgba(255,255,255,0.6);">
                        Các lễ hội và sự kiện sẽ được cập nhật sớm nhất
                    </p>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .festival-card {
        transition: all 0.3s ease;
    }

    .festival-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 40px rgba(255,107,157,0.3);
    }

    .festival-card:hover .festival-image {
        transform: scale(1.1);
    }

    .festival-card:hover .d-flex.align-items-center {
        transform: translateX(5px);
        color: #ff5a8a !important;
    }

    @@media (max-width: 768px) {
        #festival-section {
            padding: 20px 0;
        }

        .festival-card {
            margin-bottom: 20px;
        }
    }
</style>

