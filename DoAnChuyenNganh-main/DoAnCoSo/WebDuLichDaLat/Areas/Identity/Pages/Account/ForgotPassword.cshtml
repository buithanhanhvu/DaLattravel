@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="identity-container animate__animated animate__fadeIn">
    <div class="glass-card">
        <div class="brand-header text-center mb-4">
            <h1 class="logo-text">Đà Lạt</h1>
            <p class="text-white-50">Nhập email để khôi phục mật khẩu</p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="form-floating mb-4">
                <input asp-for="Input.Email" class="form-control glass-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Địa chỉ Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold hvr-grow shadow-lg mb-3">
                Gửi yêu cầu
            </button>

            <div class="text-center mt-4 pt-2 border-top border-white-10">
                <a asp-page="./Login" class="fw-bold custom-link">Quay lại đăng nhập</a>
            </div>
        </form>
    </div>
</div>

<style>
    .identity-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 20px 20px;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 24px;
        padding: 3rem;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .glass-input {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: white !important;
        border-radius: 12px !important;
    }

    .glass-input:focus {
        background: rgba(255, 255, 255, 0.1) !important;
        border-color: #ffd700 !important;
        box-shadow: 0 0 0 0.25rem rgba(255, 215, 0, 0.25) !important;
    }

    .form-floating > label {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #ffd700 !important;
    }

    .custom-link {
        color: #ffd700 !important;
        transition: all 0.3s ease;
    }

    .custom-link:hover {
        color: white !important;
        text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
    }

    .border-white-10 {
        border-color: rgba(255, 255, 255, 0.1) !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

